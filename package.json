{
  "name": "asta-hub",
  "version": "1.0.0",
  "description": "Personal Open-Source GitHub Repository & Direct Windows App Library",
  "main": "dist-main/main/main.js",
  "author": "ASTA",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && node scripts/start.mjs",
    "test": "node scripts/run-tests.mjs",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:portable-folder": "node scripts/pack-portable.mjs",
    "pack:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "lucide-react": "^1.80.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.0",
    "vite": "^8.3.8"
  }
}
